# Domaine public de l'application (le DNS doit pointer vers le VPS)
APP_DOMAIN=yayoextractor.louis-nectoux.fr

# Fournisseur de PO tokens YouTube (conteneur sidecar, voir compose.yaml)
POT_PROVIDER_URL=http://potprovider:4416

# Proxy sortant pour yt-dlp (sidecar WARP) — indispensable sur un VPS,
# sinon YouTube répond « Sign in to confirm you're not a bot »
YTDLP_PROXY=socks5h://warp:1080

# Webhook Discord prévenu à chaque conversion réussie (laisser vide pour désactiver)
DISCORD_WEBHOOK_URL=

# Durée maximale des vidéos acceptées, en minutes
MAX_DURATION_MINUTES=180

# Durée de conservation des fichiers convertis avant nettoyage, en minutes
JOB_TTL_MINUTES=60
